} > "$RUN_DIR/briefs/gate-<m>-codex.prompt"
_CODEX_STATUS=ABSENT; _V=""; _PREV=""
if [ "$_CODEX_ENABLED" = "disabled" ] || [ "$_CODEX_ENABLED" = "off" ]; then
