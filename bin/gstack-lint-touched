#!/usr/bin/env bash
# gstack-lint-touched — PostToolUse hook (Edit|Write): lint-CHECK the touched file only.
# Instant write-time feedback instead of round-3 review corrections.
#
# Contract:
#   - CHECK ONLY, never --fix: an autofix mutates the file behind the agent's back and
#     desyncs the harness's tracked file state (subsequent Edits fail on stale old_string).
#   - Touched file only, JS/TS only, and only when the file's repo has a lint config.
#     No config / non-JS file / any parse problem -> exit 0 silently (fail-OPEN: this
#     hook must never break editing).
#   - On findings: print them (capped) and exit 2 -> PostToolUse surfaces stderr to the
#     agent as feedback; the write itself already happened, nothing is blocked.
#   - Typecheck is deliberately NOT here: tsc has no single-file mode that respects the
#     project graph; ship's Step 5/16 gate owns typecheck.
# Installed via: gstack-settings-hook add-event --source ship-gate (rollback-able).
set -uo pipefail

INPUT=$(cat)

# Extract tool_input.file_path — grep fast-path, python fallback (mirrors check-careful.sh).
FILE=$(printf '%s' "$INPUT" | grep -o '"file_path"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*:[[:space:]]*"//;s/"$//' || true)
if [ -z "$FILE" ]; then
  FILE=$(printf '%s' "$INPUT" | python3 -c 'import sys,json; print(json.loads(sys.stdin.read()).get("tool_input",{}).get("file_path",""))' 2>/dev/null || true)
fi
[ -n "$FILE" ] && [ -f "$FILE" ] || exit 0

# JS/TS surface only.
case "$FILE" in
  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs) : ;;
  *) exit 0 ;;
esac

# Never lint generated/vendored output.
case "$FILE" in
  */node_modules/*|*/dist/*|*/build/*|*.gen.ts|*/generated/*|*.min.js) exit 0 ;;
esac

# Find the file's repo root (fall back to its directory).
DIR=$(dirname "$FILE")
ROOT=$(cd "$DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
[ -n "$ROOT" ] || ROOT="$DIR"

# Detect a lint config at the repo root; no config -> silent exit (do not impose a linter).
LINT=""
if [ -f "$ROOT/biome.json" ] || [ -f "$ROOT/biome.jsonc" ]; then
  LINT="bunx @biomejs/biome check"   # NOT bare "bunx biome": that resolves to an unrelated squatted npm package (biome@0.3.x) that exits 0 on anything
elif ls "$ROOT"/.eslintrc* "$ROOT"/eslint.config.* >/dev/null 2>&1; then
  LINT="bunx eslint"                 # check-only is eslint's default; --fix is never passed here
else
  exit 0
fi

OUT=$(cd "$ROOT" && $LINT "$FILE" 2>&1)
RC=$?
[ "$RC" -eq 0 ] && exit 0

# Findings: cap the output, send to stderr, exit 2 so the agent sees it as feedback.
{
  echo "lint ($LINT) found issues in ${FILE#"$ROOT"/} — fix before shipping (check-only; nothing was modified):"
  printf '%s\n' "$OUT" | head -20
} >&2
exit 2
