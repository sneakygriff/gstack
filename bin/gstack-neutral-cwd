#!/usr/bin/env bash
# gstack-neutral-cwd — create a fresh, EMPTY working directory that no project
# config can reach. The SINGLE source of the "neutral cwd" an agentic CLI runs
# from when it runs OUTSIDE its OS sandbox: bin/gstack-panel's opted-in grok
# sandbox-refusal fallback and plan-deliverables' grok gap-check.
#
#   gstack-neutral-cwd <prefix>        prefix: [A-Za-z0-9._-]+
#
# Creates `mktemp -d "${TMPDIR:-/tmp}/<prefix>-XXXXXX"`, resolves it PHYSICALLY
# (`cd … && pwd -P` — a symlinked or relative TMPDIR cannot hide where it really
# lives), verifies it is empty, then walks EVERY ancestor from the resolved dir
# itself up to `/` and FAILS CLOSED if any of them contains `.git` (file or dir)
# or a project-config name grok/claude/cursor would load — bin/gstack-lane's
# GL_GROK_PROJECT_NAMES, plus `.grokrc*` (pinned by
# test/skill-recipe-invariants.test.ts). The walk NEVER runs git, so no
# GIT_DIR / GIT_CEILING_DIRECTORIES / GIT_DISCOVERY_ACROSS_FILESYSTEM can stop it
# early (a `git rev-parse` guard reads "stopped at the ceiling" as "outside a
# checkout"); every GIT_* variable is unset anyway. Fixed-name lookups go THROUGH
# THE FILESYSTEM (`[ -e ]`), so a case-insensitive volume's `.GROK` counts as
# `.grok`; the `.grokrc*` glob runs under nocaseglob (bash globbing is
# case-sensitive even on a case-insensitive volume).
#
# The same walk also FAILS CLOSED on any ancestor that is writable by group or
# others, or owned by anyone but you or root: such a user could create .grok /
# AGENTS.md there AFTER this check and before the CLI starts (TOCTOU). The sticky
# bit does not help (1777 stops deletion, not creation), so /tmp itself fails.
#
# Success: prints the absolute physical path, exit 0. ANY failure: removes the
# dir it created, prints one line on stderr, exit 1 (usage error: exit 2). It
# never falls back to another base dir — a caller treats failure as "no neutral
# cwd" and refuses to run unsandboxed.
#
# Note: a TMPDIR under $HOME fails closed too ($HOME usually holds .claude/
# .cursor/.grok), and so does one under /tmp (1777). The macOS default TMPDIR
# (/var/folders/<id>/T: 755/700 dirs owned by you or root) passes; on Linux set
# TMPDIR to a private (0700) dir outside /tmp and $HOME's config, or no neutral
# cwd exists and the unsandboxed fallback is refused.
#
# Hygiene: bash 3.2 compatible; no `set -e`; CDPATH unset.

set -u
unset CDPATH
for _v in $(compgen -v GIT_ 2>/dev/null); do unset "$_v" 2>/dev/null; done

NEUTRAL_CWD_DENY_NAMES=".git .grok .claude .cursor .mcp.json .cursorrules .envrc .grokrc AGENTS.md AGENTS.local.md CLAUDE.md CLAUDE.local.md"

prefix="${1:-}"
if [ "$#" -ne 1 ] || [ -z "$prefix" ] || ! [[ "$prefix" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "usage: gstack-neutral-cwd <prefix>   (prefix: [A-Za-z0-9._-]+)" >&2
  exit 2
fi

created=""
fail() {
  [ -n "$created" ] && rm -rf "$created" 2>/dev/null
  echo "gstack-neutral-cwd: $1 — no neutral cwd (fail-closed)" >&2
  exit 1
}

base="${TMPDIR:-/tmp}"
created="$(mktemp -d "${base%/}/$prefix-XXXXXX" 2>/dev/null)" || { created=""; fail "mktemp -d under '$base' failed"; }
[ -n "$created" ] || fail "mktemp -d under '$base' returned nothing"
phys="$(cd "$created" 2>/dev/null && pwd -P)" || fail "cannot resolve '$created'"
case "$phys" in
  /*) ;;
  *) fail "resolved path is not absolute: '$phys'" ;;
esac
case "$phys" in *$'\n'*) fail "resolved path contains a newline" ;; esac
created="$phys"   # remove the PHYSICAL dir on failure from here on
[ -z "$(ls -A "$phys" 2>/dev/null)" ] || fail "'$phys' is not empty"

uid="$(id -u 2>/dev/null)"
# 0 (= unsafe) when <dir> is group/other-writable, owned by neither you nor root,
# or `find` cannot tell (fail closed). Portable BSD+GNU find primaries.
_unsafe_dir() {
  local o
  o="$(find "$1" -maxdepth 0 \( -perm -020 -o -perm -002 \) -print 2>/dev/null)" || return 0
  [ -n "$o" ] && return 0
  o="$(find "$1" -maxdepth 0 ! -user "$uid" ! -user 0 -print 2>/dev/null)" || return 0
  [ -n "$o" ] && return 0
  return 1
}

d="$phys"
while :; do
  for n in $NEUTRAL_CWD_DENY_NAMES; do
    if [ -e "$d/$n" ] || [ -L "$d/$n" ]; then
      fail "ancestor '$d' contains '$n'"
    fi
  done
  # bash globs are case-sensitive even on a case-insensitive volume — match
  # `.grokrc*` case-insensitively (nullglob: no match → no iteration).
  shopt -s nocaseglob nullglob
  for f in "${d%/}"/.grokrc*; do
    shopt -u nocaseglob nullglob
    fail "ancestor '$d' contains '$(basename "$f")'"
  done
  shopt -u nocaseglob nullglob
  # TOCTOU: another user able to write here could add .grok/AGENTS.md after this
  # walk; the sticky bit (1777) only stops deletion, so it does not make it safe.
  _unsafe_dir "$d" && fail "ancestor '$d' is writable by other users (or not owned by you/root) — set TMPDIR to a private directory"
  [ "$d" = "/" ] && break
  d="$(dirname "$d")"
done

printf '%s\n' "$phys"
exit 0
