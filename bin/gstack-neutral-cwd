#!/usr/bin/env bash
# gstack-neutral-cwd — create a fresh, EMPTY working directory that no project
# config can reach. The SINGLE source of the "neutral cwd" an agentic CLI runs
# from when it runs OUTSIDE its OS sandbox: bin/gstack-panel's opted-in grok
# sandbox-refusal fallback and plan-deliverables' grok gap-check.
#
#   gstack-neutral-cwd <prefix>        prefix: [A-Za-z0-9._-]+
#
# Resolves the base `${TMPDIR:-/tmp}` PHYSICALLY (`cd … && pwd -P` — a symlinked
# or relative TMPDIR cannot hide where it really lives) and walks EVERY ancestor
# from that base up to `/` BEFORE creating anything, FAILING CLOSED if any of
# them contains `.git` (file or dir) or a project-config name grok/claude/cursor
# would load — bin/gstack-lane's GL_GROK_PROJECT_NAMES, plus `.grokrc*` (pinned by
# test/skill-recipe-invariants.test.ts). The walk NEVER runs git, so no
# GIT_DIR / GIT_CEILING_DIRECTORIES / GIT_DISCOVERY_ACROSS_FILESYSTEM can stop it
# early (a `git rev-parse` guard reads "stopped at the ceiling" as "outside a
# checkout"); every GIT_* variable is unset anyway. Fixed-name lookups go THROUGH
# THE FILESYSTEM (`[ -e ]`), so a case-insensitive volume's `.GROK` counts as
# `.grok`; the `.grokrc*` glob runs under nocaseglob (bash globbing is
# case-sensitive even on a case-insensitive volume).
#
# The same walk also FAILS CLOSED on any ancestor that is writable by group or
# others, or owned by anyone but you or root: such a user could create .grok /
# AGENTS.md there AFTER this check and before the CLI starts (TOCTOU), or swap
# the dir mktemp makes for a symlink. The sticky bit does not help (1777 stops
# deletion, not creation), so /tmp itself fails.
#
# Only then: `mktemp -d "<physical base>/<prefix>-XXXXXX"`, and the result must
# BE that fresh dir — a real directory (not a symlink) directly under the
# physical base, resolving to itself, owned by you, not group/other-writable,
# empty. The cleanup target is ALWAYS the path mktemp returned (never a resolved
# one) and is removed with `rmdir` (non-recursive, never follows a symlink), so
# a swapped-in symlink can never redirect a delete onto its target.
#
# Success: prints the absolute physical path, exit 0. ANY failure: removes the
# dir it created (if any), prints one line on stderr, exit 1 (usage error: exit
# 2). It never falls back to another base dir — a caller treats failure as "no
# neutral cwd" and refuses to run unsandboxed.
#
# OPERATORS — when the opted-in unsandboxed fallback is UNAVAILABLE: this helper
# fails closed (and bin/gstack-panel's grok / plan-deliverables' grok gap-check
# then stay ABSENT/refused even with grok_allow_unsandboxed=true) whenever
# TMPDIR resolves to a place where
#   - any ancestor is group/other-writable or foreign-owned — e.g. Linux's
#     default /tmp or /var/tmp (1777), or any dir beneath them; or
#   - any ancestor holds `.git` or agent config — e.g. a TMPDIR under $HOME
#     (which usually holds .claude/.cursor/.grok) or inside a checkout.
# The macOS default TMPDIR (/var/folders/<id>/T: 755/700 dirs owned by you or
# root) passes. Elsewhere, point TMPDIR at a private 0700 dir outside $HOME, /tmp
# and every checkout — e.g. `export TMPDIR="$XDG_RUNTIME_DIR"` (/run/user/<uid>)
# on systemd Linux, or a root-created /var/lib/<you>-tmp owned by you, mode 0700.
#
# Hygiene: bash 3.2 compatible; no `set -e`; CDPATH unset.

set -u
unset CDPATH
for _v in $(compgen -v GIT_ 2>/dev/null); do unset "$_v" 2>/dev/null; done

NEUTRAL_CWD_DENY_NAMES=".git .grok .claude .cursor .mcp.json .cursorrules .envrc .grokrc AGENTS.md AGENTS.local.md CLAUDE.md CLAUDE.local.md"

prefix="${1:-}"
if [ "$#" -ne 1 ] || [ -z "$prefix" ] || ! [[ "$prefix" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "usage: gstack-neutral-cwd <prefix>   (prefix: [A-Za-z0-9._-]+)" >&2
  exit 2
fi

created=""
fail() {
  # Non-recursive removal of the ONE dir mktemp made (expected empty): rmdir never
  # follows a symlink and never deletes contents, so a swapped-in symlink or a
  # planted file can only make cleanup fail, never redirect it (A1).
  [ -n "$created" ] && rmdir "$created" 2>/dev/null
  echo "gstack-neutral-cwd: $1 — no neutral cwd (fail-closed)" >&2
  exit 1
}

uid="$(id -u 2>/dev/null)"
# 0 (= unsafe) when <dir> is group/other-writable, owned by neither you nor root,
# or `find` cannot tell (fail closed). Portable BSD+GNU find primaries.
_unsafe_dir() {
  local o
  o="$(find "$1" -maxdepth 0 \( -perm -020 -o -perm -002 \) -print 2>/dev/null)" || return 0
  [ -n "$o" ] && return 0
  o="$(find "$1" -maxdepth 0 ! -user "$uid" ! -user 0 -print 2>/dev/null)" || return 0
  [ -n "$o" ] && return 0
  return 1
}

HINT="set TMPDIR to a private (0700) directory outside any checkout, \$HOME and /tmp"

# 1. Resolve the BASE physically and validate its WHOLE ancestry BEFORE creating
#    anything (A1): only a base no other user can write to is used, so nobody can
#    swap the dir mktemp makes for a symlink between creation and use.
base="${TMPDIR:-/tmp}"
base_phys="$(cd "$base" 2>/dev/null && pwd -P)" || fail "cannot resolve TMPDIR '$base'"
case "$base_phys" in
  /*) ;;
  *) fail "resolved TMPDIR is not absolute: '$base_phys'" ;;
esac
case "$base_phys" in *$'\n'*) fail "resolved TMPDIR contains a newline" ;; esac

d="$base_phys"
while :; do
  for n in $NEUTRAL_CWD_DENY_NAMES; do
    if [ -e "$d/$n" ] || [ -L "$d/$n" ]; then
      fail "ancestor '$d' contains '$n' ($HINT)"
    fi
  done
  # bash globs are case-sensitive even on a case-insensitive volume — match
  # `.grokrc*` case-insensitively (nullglob: no match → no iteration).
  shopt -s nocaseglob nullglob
  for f in "${d%/}"/.grokrc*; do
    shopt -u nocaseglob nullglob
    fail "ancestor '$d' contains '$(basename "$f")' ($HINT)"
  done
  shopt -u nocaseglob nullglob
  # TOCTOU: another user able to write here could add .grok/AGENTS.md after this
  # walk (or swap our dir); the sticky bit (1777) only stops deletion, so it does
  # not make it safe.
  _unsafe_dir "$d" && fail "ancestor '$d' is writable by other users (or not owned by you/root) — $HINT"
  [ "$d" = "/" ] && break
  d="$(dirname "$d")"
done

# 2. Create under the PHYSICAL base and verify the result IS that fresh dir: a
#    real directory (not a symlink) directly under base_phys, owned by you, mode
#    not group/other-writable, empty. `created` is never reassigned to a
#    resolved path, so cleanup can only ever target what mktemp returned.
created="$(mktemp -d "${base_phys%/}/$prefix-XXXXXX" 2>/dev/null)" || { created=""; fail "mktemp -d under '$base_phys' failed"; }
[ -n "$created" ] || fail "mktemp -d under '$base_phys' returned nothing"
case "$created" in
  "${base_phys%/}/$prefix-"*) ;;
  *) c="$created"; created=""; fail "mktemp returned '$c', not a dir directly under '$base_phys'" ;;
esac
case "${created#"${base_phys%/}/"}" in */*) c="$created"; created=""; fail "mktemp returned a nested path '$c'" ;; esac
{ [ -d "$created" ] && [ ! -L "$created" ]; } || { c="$created"; created=""; fail "'$c' is not a real directory (symlink swapped in?)"; }
phys="$(cd "$created" 2>/dev/null && pwd -P)" || fail "cannot resolve '$created'"
[ "$phys" = "$created" ] || fail "'$created' resolves elsewhere ('$phys')"
[ -n "$(find "$created" -maxdepth 0 -type d -user "$uid" -print 2>/dev/null)" ] || fail "'$created' is not a directory owned by you"
_unsafe_dir "$created" && fail "'$created' is writable by other users"
[ -z "$(ls -A "$created" 2>/dev/null)" ] || fail "'$created' is not empty"

printf '%s\n' "$created"
exit 0
